<article class="order-item">
  <header class="order-summary">
    <h2><span class="order-item-price">$<%= order.productData.totalPrice.toFixed(2) %></span> - <%= order.formattedDate %></h2>
    <p><span class="badge"><%= order.status.toUpperCase() %></span></p>
  </header>

  <section class="order-details">
    <% if (locals.isAdmin) { %>
      <address>
        <p><a href="mailto:<%= order.userData.email %>"><%= order.userData.fullname %></a>   
          <span><%= order.userData.phoneNumber %></span>
        </p>
        <p><%= order.userData.address.street %> (<%= order.userData.address.postal %> <%= order.userData.address.city %>)</p>
      </address>
    <% } %>
    <ul>
      <% for (const item of order.productData.items) { %>
        <li><%= item.product.title %> - $<%= item.totalPrice.toFixed(2) %> ($<%= item.product.price.toFixed(2) %> x <%= item.quantity %>)</li>
      <% } %>
    </ul>
  </section>

  <% if (locals.isAdmin) { %>
    <section class="order-actions">
      <form>
        <input type="hidden" name="_csrf" value="<%= locals.csrfToken %>">
        <input type="hidden" name="orderid" value="<%= order.id %>">
        <select name="status">
          <option value="processing" <% if (order.status === 'processing') { %>selected<% } %>>Processing</option>
          <option value="packed" <% if (order.status === 'packed') { %>selected<% } %>>Packed</option>
          <option value="shipped-to-courier" <% if (order.status === 'shipped-to-courier') { %>selected<% } %>>Shipped to Courier</option>
          <option value="in-transit" <% if (order.status === 'in-transit') { %>selected<% } %>>In Transit</option>
          <option value="arrived" <% if (order.status === 'arrived') { %>selected<% } %>>Arrived</option>
          <option value="completed" <% if (order.status === 'completed') { %>selected<% } %>>Completed</option>
          <option value="rejected" <% if (order.status === 'rejected') { %>selected<% } %>>Rejected</option>
        </select>
        <button class="btn btn-alt">Update</button>
      </form>
    </section>
  <% } %>
</article>